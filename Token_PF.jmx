            <stringProp name="script">import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

// Define the file path
String filePath = &quot;C:\\PRF\\Data\\dev_token2.csv&quot;;

// Define the headers
String headers = &quot;token&quot;;

// Get the response data
String responseData = prev.getResponseDataAsString();

// Define the regex pattern to extract the token
Pattern pattern = Pattern.compile(&quot;\&quot;token\&quot;:\&quot;([^\&quot;]+)\&quot;&quot;);
Matcher matcher = pattern.matcher(responseData);

String token = &quot;&quot;;
if (matcher.find()) {
    token = matcher.group(1);
}

// Check if the file exists
File file = new File(filePath);
boolean fileExists = file.exists();

FileWriter fw = null;
PrintWriter pw = null;

try {
    // Overwrite the file at the beginning of each execution
    fw = new FileWriter(filePath, false); // &apos;false&apos; to overwrite the file
    pw = new PrintWriter(fw);

    // Write headers
    pw.println(headers);

    // Write the token
    pw.println(token);

} catch (IOException e) {
    e.printStackTrace();
} finally {
    if (pw != null) {
        pw.close();
    }
    if (fw != null) {
        try {
            fw.close();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
