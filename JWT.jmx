        <kg.apc.jmeter.samplers.DummySampler guiclass="kg.apc.jmeter.samplers.DummySamplerGui" testclass="kg.apc.jmeter.samplers.DummySampler" testname="JWT Encode" enabled="true">
          <boolProp name="WAITING">true</boolProp>
          <boolProp name="SUCCESFULL">true</boolProp>
          <stringProp name="RESPONSE_CODE">200</stringProp>
          <stringProp name="RESPONSE_MESSAGE">OK</stringProp>
          <stringProp name="REQUEST_DATA">Dummy Sampler used to simulate requests and responses
without actual network activity. This helps debugging tests.</stringProp>
          <stringProp name="RESPONSE_DATA">${jwt_token}</stringProp>
          <stringProp name="RESPONSE_TIME">${__Random(50,500)}</stringProp>
          <stringProp name="LATENCY">${__Random(1,50)}</stringProp>
          <stringProp name="CONNECT">${__Random(1,5)}</stringProp>
          <stringProp name="URL"></stringProp>
          <stringProp name="RESULT_CLASS">org.apache.jmeter.samplers.SampleResult</stringProp>
        </kg.apc.jmeter.samplers.DummySampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.security.KeyFactory
import java.security.PrivateKey
import java.security.spec.PKCS8EncodedKeySpec
import java.util.Base64
import java.security.Signature

// Helper function to perform Base64 URL encoding
def base64UrlEncode(byte[] input) {
    String base64 = Base64.getEncoder().encodeToString(input)
    return base64.replace(&apos;+&apos;, &apos;-&apos;).replace(&apos;/&apos;, &apos;_&apos;).replace(&apos;=&apos;, &apos;&apos;)
}

// Helper function to perform JWT encoding
def createJwt(header, payload, privateKey) {
    // Encode header and payload in Base64 URL
    String headerBase64 = base64UrlEncode(header.getBytes(&apos;UTF-8&apos;))
    String payloadBase64 = base64UrlEncode(payload.getBytes(&apos;UTF-8&apos;))

    // Create the signature
    String dataToSign = &quot;${headerBase64}.${payloadBase64}&quot;
    Signature signer = Signature.getInstance(&apos;SHA256withRSA&apos;)
    signer.initSign(privateKey)
    signer.update(dataToSign.getBytes(&apos;UTF-8&apos;))
    byte[] signature = signer.sign()
    String signatureBase64 = base64UrlEncode(signature)

    // Return the JWT
    return &quot;${headerBase64}.${payloadBase64}.${signatureBase64}&quot;
}

// Define your RSA private key as a Base64 encoded string (PKCS#8 format)
def privateKeyBase64 = &apos;&apos;

// Decode the private key
byte[] privateKeyBytes = Base64.getDecoder().decode(privateKeyBase64)
PKCS8EncodedKeySpec spec = new PKCS8EncodedKeySpec(privateKeyBytes)
KeyFactory keyFactory = KeyFactory.getInstance(&apos;RSA&apos;)
PrivateKey privateKey = keyFactory.generatePrivate(spec)

// Define JWT header and payload as JSON strings
String header = &apos;{&quot;alg&quot;:&quot;RS256&quot;,&quot;typ&quot;:&quot;JWT&quot;}&apos;
String payload = &apos;{&quot;abc&quot;:&quot;123&quot;,&quot;def&quot;:&quot;234&quot;,&quot;efg&quot;:345,&quot;hij&quot;:&quot;456&quot;}&apos;

// Create JWT
String jwt = createJwt(header, payload, privateKey)

// Output the JWT to JMeter log for debugging
log.info(&quot;Encoded JWT: ${jwt}&quot;)

// Optionally, store the JWT in a JMeter variable for use in other samplers
vars.put(&quot;jwt_token&quot;, jwt)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <kg.apc.jmeter.samplers.DummySampler guiclass="kg.apc.jmeter.samplers.DummySamplerGui" testclass="kg.apc.jmeter.samplers.DummySampler" testname="JWT Decode" enabled="true">
          <boolProp name="WAITING">true</boolProp>
          <boolProp name="SUCCESFULL">true</boolProp>
          <stringProp name="RESPONSE_CODE">200</stringProp>
          <stringProp name="RESPONSE_MESSAGE">OK</stringProp>
          <stringProp name="REQUEST_DATA">Dummy Sampler used to simulate requests and responses
without actual network activity. This helps debugging tests.</stringProp>
          <stringProp name="RESPONSE_DATA">${jwt_header}
${jwt_payload}</stringProp>
          <stringProp name="RESPONSE_TIME">${__Random(50,500)}</stringProp>
          <stringProp name="LATENCY">${__Random(1,50)}</stringProp>
          <stringProp name="CONNECT">${__Random(1,5)}</stringProp>
          <stringProp name="URL"></stringProp>
          <stringProp name="RESULT_CLASS">org.apache.jmeter.samplers.SampleResult</stringProp>
        </kg.apc.jmeter.samplers.DummySampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">

import java.util.Base64

// Helper function to perform Base64 URL decoding
def base64UrlDecode(String input) {
    // Base64 URL encoding replaces + with - and / with _
    String base64 = input.replace(&apos;-&apos;, &apos;+&apos;).replace(&apos;_&apos;, &apos;/&apos;)
    // Add padding if necessary
    int padding = (4 - (base64.length() % 4)) % 4
    base64 += &apos;=&apos; * padding
    return Base64.getDecoder().decode(base64)
}

// Function to decode a JWT token
def decodeJwt(String jwt) {
    def parts = jwt.split(/[.]/)
    //String[] parts = jwt.split(&apos;\\.&apos;);
    if (parts.length != 3) {
        throw new IllegalArgumentException(&quot;Invalid JWT token&quot;)
    }
    
    String headerBase64 = parts[0]
    String payloadBase64 = parts[1]
    
    // Decode Base64 URL encoded header and payload
    String headerJson = new String(base64UrlDecode(headerBase64), &apos;UTF-8&apos;)
    String payloadJson = new String(base64UrlDecode(payloadBase64), &apos;UTF-8&apos;)
    
    return [header: headerJson, payload: payloadJson]
}

// Example JWT token (replace with your JWT token)
def jwtToken = vars.get(&apos;jwt_token&apos;)

// Decode the JWT token
def decodedJwt = decodeJwt(jwtToken)

// Output the decoded JWT to JMeter log for debugging
log.info(&quot;Decoded JWT Header: ${decodedJwt.header}&quot;)
log.info(&quot;Decoded JWT Payload: ${decodedJwt.payload}&quot;)

// Optionally, store the decoded JWT components in JMeter variables for use in other samplers
vars.put(&quot;jwt_header&quot;, decodedJwt.header)
vars.put(&quot;jwt_payload&quot;, decodedJwt.payload)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
